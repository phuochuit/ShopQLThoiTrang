@{
    ViewBag.Title = "Thống kê doanh thu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid mt-4">
    <h2 class="text-center text-uppercase font-weight-bold mb-4" style="color: #2c3e50;">Báo cáo thống kê</h2>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary shadow h-100">
                <div class="card-body">
                    <h5 class="card-title text-uppercase font-size-sm">Doanh thu tháng @DateTime.Now.Month</h5>
                    <h3 class="font-weight-bold">@string.Format("{0:N0} đ", ViewBag.DoanhThuThang)</h3>
                    <small>Đơn hàng đã thanh toán/giao</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-success shadow h-100">
                <div class="card-body">
                    <h5 class="card-title text-uppercase">Tổng doanh thu</h5>
                    <h3 class="font-weight-bold">@string.Format("{0:N0} đ", ViewBag.TongDoanhThu)</h3>
                    <small>Toàn thời gian</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-warning shadow h-100">
                <div class="card-body">
                    <h5 class="card-title text-uppercase">Đơn chờ duyệt</h5>
                    <h3 class="font-weight-bold">@ViewBag.DonHangMoi</h3>
                    <small>Cần xử lý ngay</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-danger shadow h-100">
                <div class="card-body">
                    <h5 class="card-title text-uppercase">Đơn đã hủy</h5>
                    <h3 class="font-weight-bold">@ViewBag.DonHangHuy</h3>
                    <small>Tổng số đơn bị hủy</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Biểu đồ doanh thu năm @DateTime.Now.Year</h6>
                </div>
                <div class="card-body">
                    <canvas id="myChart" height="150"></canvas>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Top 5 Sản phẩm bán chạy</h6>
                </div>
                <div class="card-body p-0">
                    @Html.Action("TopSanPham", "ThongKe")
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    // Lấy dữ liệu từ ViewBag
    var chartDataStr = "@ViewBag.ChartData";
    var dataArray = chartDataStr.split(',').map(Number); // Chuyển chuỗi thành mảng số

    var ctx = document.getElementById('myChart').getContext('2d');
    var myChart = new Chart(ctx, {
        type: 'bar', // Loại biểu đồ: bar (cột), line (đường)
        data: {
            labels: ['Tháng 1', 'Tháng 2', 'Tháng 3', 'Tháng 4', 'Tháng 5', 'Tháng 6', 'Tháng 7', 'Tháng 8', 'Tháng 9', 'Tháng 10', 'Tháng 11', 'Tháng 12'],
            datasets: [{
                label: 'Doanh thu (VNĐ)',
                data: dataArray,
                backgroundColor: 'rgba(54, 162, 235, 0.6)',
                borderColor: 'rgba(54, 162, 235, 1)',
                borderWidth: 1
            }]
        },
        options: {
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        callback: function(value, index, values) {
                            return value.toLocaleString('vi-VN') + ' đ'; // Định dạng tiền tệ trục Y
                        }
                    }
                }
            },
            plugins: {
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            let label = context.dataset.label || '';
                            if (label) {
                                label += ': ';
                            }
                            if (context.parsed.y !== null) {
                                label += new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(context.parsed.y);
                            }
                            return label;
                        }
                    }
                }
            }
        }
    });
</script>