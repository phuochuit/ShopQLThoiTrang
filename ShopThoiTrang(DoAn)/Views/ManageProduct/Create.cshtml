@model ShopThoiTrang_DoAn_.SanPham

@{
    ViewBag.Title = "Thêm sản phẩm mới";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2 class="text-center text-primary">THÊM SẢN PHẨM MỚI</h2>

    @using (Html.BeginForm("Create", "ManageProduct", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
    @Html.AntiForgeryToken()

    <div class="card shadow p-4">
        <div class="form-horizontal">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-group row mb-3">
                <label class="col-md-2 col-form-label font-weight-bold">Tên sản phẩm</label>
                <div class="col-md-10">
                    @Html.EditorFor(model => model.TenSP, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập tên sản phẩm..." } })
                    @Html.ValidationMessageFor(model => model.TenSP, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group row mb-3">
                <label class="col-md-2 col-form-label font-weight-bold">Danh mục</label>
                <div class="col-md-4">
                    @Html.DropDownList("MaDM", null, "--- Chọn danh mục ---", new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.MaDM, "", new { @class = "text-danger" })
                </div>

                <label class="col-md-2 col-form-label font-weight-bold text-end">Giá bán</label>
                <div class="col-md-4">
                    @Html.EditorFor(model => model.Gia, new { htmlAttributes = new { @class = "form-control", type = "number" } })
                    @Html.ValidationMessageFor(model => model.Gia, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group row mb-3">
                <label class="col-md-2 col-form-label font-weight-bold">Ảnh đại diện</label>
                <div class="col-md-10">
                    <input type="file" name="uploadHinh" class="form-control" accept="image/*" required />
                    <small class="text-muted">Chỉ nhận file ảnh (jpg, png, jpeg)</small>
                </div>
            </div>

            <div class="form-group row mb-3">
                <label class="col-md-2 col-form-label font-weight-bold">Ảnh liên quan</label>
                <div class="col-md-10">
                    <input type="file" name="files" class="form-control" accept="image/*" required multiple />
                    <small class="text-muted">Chỉ nhận file ảnh (jpg, png, jpeg)</small>
                </div>
            </div>

            <div class="form-group row mb-3">
                <label class="col-md-2 col-form-label font-weight-bold">Mô tả ngắn</label>
                <div class="col-md-10">
                    @Html.TextAreaFor(model => model.MoTa1, new { @class = "form-control", rows = 3 })
                </div>
            </div>

            <div class="form-group row mb-3">
                <label class="col-md-2 col-form-label font-weight-bold">Mô tả chi tiết</label>
                <div class="col-md-10">
                    @Html.TextAreaFor(model => model.MoTa2, new { @class = "form-control", rows = 5 })
                </div>
            </div>

            <div class="form-group row mt-4">
                <div class="col-md-10 offset-md-2">
                    <button type="submit" class="btn btn-success btn-lg">
                        <i class="fa fa-save"></i> Lưu sản phẩm
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary btn-lg ml-2">Quay lại</a>
                </div>
            </div>
        </div>
    </div>
    }
</div>