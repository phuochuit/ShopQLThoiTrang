@model IEnumerable<ShopThoiTrang_DoAn_.SanPham>

@{
    ViewBag.Title = "Quản lý sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid mt-4">
    <h2 class="text-center text-primary font-weight-bold">DANH SÁCH SẢN PHẨM</h2>

    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

    <div class="card p-3 mb-4 bg-light shadow-sm">
        @using (Html.BeginForm("Index", "ManageProduct", FormMethod.Get, new { @class = "row align-items-end" }))
        {
        <div class="col-md-4">
            <label>Từ khóa (Tên SP):</label>
            <input type="text" name="tuKhoa" value="@ViewBag.CurrentFilter" class="form-control" placeholder="Nhập tên..." />
        </div>
        <div class="col-md-3">
            <label>Danh mục:</label>
            @Html.DropDownList("maDM", (SelectList)ViewBag.ListDM, "--- Tất cả ---", new { @class = "form-control" })
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary">
                <i class="fa fa-search"></i> Tìm kiếm
            </button>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Reset</a>
        </div>
        <div class="col-md-2 text-end">
            <a href="@Url.Action("Create")" class="btn btn-success w-100">
                + Thêm mới
            </a>
        </div>
        }
    </div>

    <table class="table table-bordered table-hover align-middle">
        <thead class="thead-dark bg-dark text-white">
            <tr>
                <th width="50">ID</th>
                <th>
                    @Html.ActionLink("Tên sản phẩm ⇅", "Index", new { sortOrder = ViewBag.NameSortParm, tuKhoa = ViewBag.CurrentFilter, maDM = ViewBag.CurrentMaDM }, new { @class = "text-white text-decoration-none" })
                </th>
                <th width="100">Ảnh</th>
                <th>
                    @Html.ActionLink("Giá bán ⇅", "Index", new { sortOrder = ViewBag.PriceSortParm, tuKhoa = ViewBag.CurrentFilter, maDM = ViewBag.CurrentMaDM }, new { @class = "text-white text-decoration-none" })
                </th>
                <th>Danh mục</th>
                <th width="180">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count() == 0)
            {
            <tr><td colspan="6" class="text-center text-muted py-3">Không tìm thấy sản phẩm nào.</td></tr>
            }
            else
            {
                foreach (var item in Model)
                {
            <tr>
                <td>@item.MaSP</td>
                <td class="font-weight-bold">@item.TenSP</td>
                <td class="text-center">
                    <img src="~/Content/images/@item.AnhDaiDien" width="60" height="60" style="object-fit: cover; border-radius: 4px; border: 1px solid #ddd;" />
                </td>
                <td class="text-danger fw-bold">@string.Format("{0:N0} đ", item.Gia)</td>
                <td>
                    @if (item.DanhMuc != null)
                            {
                    <span class="badge bg-info text-dark">@item.DanhMuc.TenDM</span>
                            }
                </td>
                <td>
                    <a href="@Url.Action("Edit", new { id = item.MaSP })" class="btn btn-warning btn-sm">
                        ✏ Sửa
                    </a>

                    <a href="@Url.Action("Delete", new { id = item.MaSP })"
                       class="btn btn-danger btn-sm"
                       onclick="return confirm('Bạn có chắc muốn xóa sản phẩm: @item.TenSP ? \nCảnh báo: Hành động này không thể hoàn tác!');">
                        🗑 Xóa
                    </a>
                </td>
            </tr>
                }
            }
        </tbody>
    </table>
</div>