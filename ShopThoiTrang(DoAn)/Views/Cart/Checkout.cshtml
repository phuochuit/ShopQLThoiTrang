@model ShopThoiTrang_DoAn_.Models.Cart
@{
    ViewBag.Title = "Thanh toán";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2>Xác nhận đơn hàng</h2>
    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-primary text-white">Thông tin giao hàng</div>
                <div class="card-body">
                    <form action="@Url.Action("Payment", "Cart")" method="post">

                        <div class="form-group">
                            <label>Họ tên người nhận (*)</label>
                            <input type="text" name="shipName" class="form-control" required
                                   value="@ViewBag.HoTen" />
                        </div>

                        <div class="form-group">
                            <label>Số điện thoại (*)</label>
                            <input type="text" name="mobile" class="form-control" required
                                   value="@ViewBag.SDT" placeholder="Nhập số điện thoại..." />
                        </div>

                        <div class="form-group">
                            <label>Địa chỉ giao hàng (*)</label>
                            <input type="text" name="address" class="form-control" required
                                   value="@ViewBag.DiaChi" placeholder="Nhập địa chỉ nhận hàng..." />
                        </div>

                        <div class="form-group">
                            <label>Email</label>
                            <input type="email" name="email" class="form-control" readonly
                                   value="@ViewBag.Email" />
                        </div>

                        <hr />
                        <button type="submit" class="btn btn-success btn-block btn-lg">
                            XÁC NHẬN THANH TOÁN
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Sản phẩm mua</div>
                <div class="card-body">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Tên SP</th>
                                <th>SL</th>
                                <th>Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.list)
                            {
                            <tr>
                                <td>@item.TenSP - @item.Mau - Size @item.Size</td>
                                <td>@item.SoLuong</td>
                                <td>@item.ThanhTien.ToString("N0") đ</td>
                            </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="font-weight-bold text-danger">
                                <td colspan="2">TỔNG TIỀN:</td>
                                <td>@Model.TongThanhTien().ToString("N0") đ</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>