@{ ViewBag.Title = "Quên mật khẩu"; Layout = "~/Views/Shared/_Layout.cshtml"; }

<h2>Quên mật khẩu</h2>
@if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }

<form action="@Url.Action("SendOtp", "User")" method="post">
    <div class="form-group">
        <label>Nhập Email đăng ký của bạn:</label>
        <input type="email" name="email" class="form-control" required />
    </div>
    <br />
    <button type="submit" class="btn btn-primary">Gửi mã OTP</button>
</form>