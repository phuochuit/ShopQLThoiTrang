<div class="container-fluid d-flex justify-content-center align-items-center min-vh-1">
    <div class="card" style="width: 400px;">
        <div class="card-body p-5">
            <h4 class="card-title text-center mb-1">Đăng nhập</h4>
            <p class="text-center text-muted mb-4">Vui lòng nhập thông tin</p>

            @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
            {
                <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
            }

            @using (Html.BeginForm("LoginOnSubmit", "User", FormMethod.Post))
            {
                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <input type="email" class="form-control" id="email" name="email"
                           placeholder="your@email.com" required>
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">Mật Khẩu</label>
                    <div class="input-group">
                        <input type="password" class="form-control" id="password" name="password"
                               placeholder="Nhập mật khẩu" required>
                    </div>
                </div>

                <div class="mb-3 form-check">
                    <input type="checkbox" class="form-check-input" id="rememberMe" name="rememberMe">
                    <label class="form-check-label" for="rememberMe">Ghi nhớ tôi</label>
                </div>

                <button type="submit" class="btn btn-primary w-100" id="btnLogin">
                    Đăng Nhập
                </button>

                <div class="mt-3 d-flex justify-content-center">
                    <p>Chưa có tài khoản? &nbsp</p> 
                    <a href="@Url.Action("DangKy", "Home")" class="text-decoration-none">Đăng ký</a>
                </div>
            }
        </div>
    </div>
</div>
