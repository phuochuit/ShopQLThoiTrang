@model ShopThoiTrang_DoAn_.KhachHang
@{
    ViewBag.Title = "Đăng ký";
}

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>

<div class="container-fluid d-flex justify-content-center align-items-center min-vh-100 py-5">
    <div style="width: 100%; max-width: 550px;">
        <div class="form-section">
            <div class="card">
                <div class="card-body p-5">
                    <h4 class="card-title text-center mb-1">Đăng Ký Tài Khoản Khách Hàng</h4>
                    <p class="text-center text-muted mb-4">Tạo tài khoản để mua sắm dễ dàng hơn</p>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                    }

                    @using (Html.BeginForm("Register", "User", FormMethod.Post))
                    {
                        <div class="mb-3">
                            @Html.LabelFor(m => m.TenKH, "Tên Khách Hàng", new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.TenKH, new { @class = "form-control", placeholder = "Nhập tên đầy đủ" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Email, "Email", new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "your@email.com", type = "email", @id = "txtEmail", required = "required"})
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Mã Xác Thực (OTP)</label>
                            <div class="input-group">
                                <input type="text" name="otpVerify" class="form-control" placeholder="Nhập mã 6 số" required />
                                <button type="button" id="btnSendOtp" class="btn btn-warning">Gửi mã</button>
                            </div>
                            <small id="msgOtp" class="fw-bold mt-1 d-block"></small>
                            @Html.ValidationMessage("OTP", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.DienThoai, "Số Điện Thoại", new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.DienThoai, new { @class = "form-control", placeholder = "0912345678" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.MatKhau, "Mật Khẩu", new { @class = "form-label" })
                            @Html.PasswordFor(m => m.MatKhau, new { @class = "form-control", placeholder = "Nhập mật khẩu" })
                            @Html.ValidationMessageFor(m => m.MatKhau, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.GioiTinh, "Giới Tính", new { @class = "form-label" })
                            @Html.DropDownListFor(m => m.GioiTinh,
                                new SelectList(new[] { "Nam", "Nữ", "Khác" }),
                                "-- Chọn --",
                                new { @class = "form-select" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.NamSinh, "Năm Sinh", new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.NamSinh, new { @class = "form-control", type = "number", min = "1950", max = "2010", placeholder = "1990" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.DiaChi, "Địa Chỉ", new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.DiaChi, new { @class = "form-control", placeholder = "Nhập địa chỉ đầy đủ" })
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Đăng Ký</button>
                    }

                    <div class="mt-3 text-center">
                        <span class="text-muted">Đã có tài khoản? </span>
                        <a href="@Url.Action("Login", "User")" class="text-decoration-none fw-bold">Đăng nhập ngay</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<script>
    $(document).ready(function () {
        $('#btnSendOtp').click(function () {
            var email = $('#txtEmail').val();

            if (email == "") {
                alert("Vui lòng nhập Email trước khi lấy mã!");
                return;
            }

            $('#btnSendOtp').prop('disabled', true).text('Đang gửi...');
            $('#msgOtp').text('');

            $.ajax({
                url: '@Url.Action("SendOtpAjax", "User")',
                type: 'POST',
                data: { email: email },
                success: function (res) {
                    if (res.success) {
                        $('#msgOtp').css('color', 'green').text(res.message);
                    } else {
                        $('#msgOtp').css('color', 'red').text(res.message);
                        $('#btnSendOtp').prop('disabled', false).text('Gửi mã xác thực');
                    }
                },
                error: function () {
                    alert("Có lỗi xảy ra khi gọi server!");
                    $('#btnSendOtp').prop('disabled', false).text('Gửi mã xác thực');
                }
            });
        });
    });
</script>