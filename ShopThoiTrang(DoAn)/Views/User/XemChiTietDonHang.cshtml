@model IEnumerable<ShopThoiTrang_DoAn_.ChiTietHoaDon>

@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var donHang = ViewBag.DonHang as ShopThoiTrang_DoAn_.HoaDon;
}

<div class="container mt-4">
    <h3>Chi tiết đơn hàng #@donHang.MaHD</h3>
    <p>Ngày đặt: @string.Format("{0:dd/MM/yyyy}", donHang.NgayLap)</p>
    <p>Địa chỉ/Người nhận: @donHang.DiaChiGiaoHang</p>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Tên sản phẩm</th>
                <th>Ảnh</th>
                <th>Màu / Size</th>
                <th>Đơn giá</th>
                <th>Số lượng</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
            <tr>
                <td>@item.SanPham.TenSP</td>
                <td>
                    <img src="@Url.Content("~/Content/images/" + item.SanPham.AnhDaiDien)" width="50" />
                </td>
                <td>@item.Color / @item.Size</td>
                <td>@string.Format("{0:N0} đ", item.GiaBan)</td>
                <td>@item.SoLuong</td>
                <td>@string.Format("{0:N0} đ", item.GiaBan * item.SoLuong)</td>
            </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="5" class="text-right font-weight-bold">TỔNG TIỀN:</td>
                <td class="text-danger font-weight-bold">@string.Format("{0:N0} đ", donHang.TongTien)</td>
            </tr>
        </tfoot>
    </table>

    <a href="@Url.Action("LichSuDonHang", "User")" class="btn btn-secondary">Quay lại danh sách</a>
</div>