@{ ViewBag.Title = "Đặt lại mật khẩu"; Layout = "~/Views/Shared/_Layout.cshtml"; }

<h2>Đặt lại mật khẩu mới</h2>
@if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }

<form action="@Url.Action("ResetPassword", "User")" method="post">
    <div class="form-group">
        <label>Mật khẩu mới:</label>
        <input type="password" name="newPass" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Nhập lại mật khẩu:</label>
        <input type="password" name="confirmPass" class="form-control" required />
    </div>
    <br />
    <button type="submit" class="btn btn-primary">Lưu mật khẩu</button>
</form>